{
  "name": "delospace",
  "productName": "DeloSpace",
  "version": "1.0.0",
  "type": "module",
  "description": "DeloSpace · One Board for Your AI Agents",
  "main": "electron/main.js",
  "scripts": {
    "server": "node server/index.js",
    "client": "vite",
    "dev": "concurrently -k \"npm run server\" \"npm run client\"",
    "build": "vite build",
    "start": "node server/index.js",
    "electron": "electron electron/main.js",
    "desktop": "concurrently -k \"npm run server\" \"electron electron/main.js\"",
    "compile": "npm run build && electron-builder --mac --arm64 --dir",
    "install-mac": "npm run compile && cp -R release/mac-arm64/DeloSpace.app /Applications/ && /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f /Applications/DeloSpace.app",
    "dist": "npm run build && electron-builder --mac --arm64",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-*/spawn-helper 2>/dev/null || true"
  },
  "build": {
    "appId": "com.delospace.app",
    "productName": "DeloSpace",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "assets/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "dir",
        "dmg"
      ],
      "identity": null
    },
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "lucide": "^1.57.0",
    "lucide-react": "^1.57.0",
    "mermaid": "^12.2.0",
    "node-pty": "^1.1.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  }
}
